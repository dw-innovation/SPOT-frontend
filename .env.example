# Copy to .env.local and fill in, or run: vercel env pull .env.local
# See README > Environment Variables for what each one does.
# VERCEL_GIT_COMMIT_SHA is provided automatically by Vercel; set it only if you
# want the commit tagged on error reports from a local build.

# --- Backend services ---
NLP_API=
NLP_MODEL=
# Optional: use the SPOT Chat API instead of NLP_API for sentence -> query
SPOT_CHAT_API=
SPOT_CHAT_API_KEY=
SPOT_TAG_SEARCH_URL=
OSM_API=
ENVIRONMENT=
MONGODB_URI=
MONGODB_DBNAME=
MAPTILER_KEY=

# --- Authentication ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CREDENTIALS=
APP_SALT=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional basic-auth gate for the whole site: "user:pass"
HTTP_BASIC_AUTH=

# --- Client (inlined at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_VERSION=
NEXT_PUBLIC_MAINTENANCE=
# Protomaps basemap: PMTiles archive on S3 (public, CORS + Range requests)
NEXT_PUBLIC_PMTILES_URL=
NEXT_PUBLIC_PROTOMAPS_FLAVOR=light
NEXT_PUBLIC_PROTOMAPS_LANG=en
NEXT_PUBLIC_TOMTOM_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_NOMINATIM_API=
NEXT_PUBLIC_TAG_INFO_API=
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
